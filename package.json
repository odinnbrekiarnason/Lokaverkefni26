{
  "name": "lokaverkefni",
  "version": "1.0.0",
  "description": "Búðu til RESTful API fyrir miðasölukerfið svipað og Tix. Kerfið gerir notendum kleift að skoða viðburði, staði og kaupa miða. Notaðu þær venjur sem þú hefur lært í áfanganum.",
  "main": "server.ts",
  "author": "",
  "license": "isc",
  "scripts": {
    "dev": "nodemon --exec tsx src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "vitest run"
  },
  "vitest": {
    "setupFiles": ["src/models/tests/setup.ts"]
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "dotenv": "^17.2.3",
    "env": "^0.0.2",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "npm": "^11.7.0",
    "pg-promise": "^12.2.0",
    "tsx": "^4.20.6",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "^24.10.4",
    "@types/pg": "^8.15.6",
    "@types/supertest": "^6.0.3",
    "nodemon": "^3.1.10",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vitest": "^4.0.16"
  }
}
